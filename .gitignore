# 排除文件資料夾
# 排除所有 PDF 檔案
*.pdf
*.pptx
*.ppt

# 排除圖片檔案
# *.jpg
# *.jpeg
# *.png

# 排除特定的資料夾（假設您有個 temp 資料夾存放自動產生的檔案）
/_oldData/
/.vscode/
/sql/
/catalog/images/*
# 排除特定 檔案
css/bootstrap-min-5.1.1.css
pdo_config.php
**/counter.dat
**/test.php
**.txt

# 排除執行產生的紀錄檔
*.log

# 排除系統產生的隱藏檔（如 Mac 的 .DS_Store）
# .DS_Store